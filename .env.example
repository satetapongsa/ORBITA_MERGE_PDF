# --- Database (Neon) -------------------------------------------------------
# Neon console → your project → Connection details → copy the *pooled* string.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- App -----------------------------------------------------------------------
# Long random string used to sign login sessions (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me
# Public URL of the web app (used for Stripe redirects). Vite dev server by default.
APP_URL=http://localhost:5173
PORT=3001
# Daily export limits reset at midnight in this timezone.
APP_TIMEZONE=Asia/Bangkok
# Where each user's files are stored: <STORAGE_DIR>/<user-id>/...
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# --- Assistant (Pro feature) --------------------------------------------------
# AI provider key — kept server-side only; the browser only ever sees ASSISTANT_NAME.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash        # or deepseek-v4-pro (slower, pricier)
# ASSISTANT_NAME=PageSmith 5.5 Pro
# ASSISTANT_DAILY_LIMIT=100            # messages per Pro user per day

# --- Payments (Stripe, THB) ------------------------------------------------------
# Leave STRIPE_SECRET_KEY empty for local "test mode": upgrading activates Pro without charging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: a recurring 20 THB/month Price ID. If empty, the price is created inline at checkout.
STRIPE_PRICE_ID=

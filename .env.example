# Required environment variables. Everything else has a sensible default.

# Neon connection string (Neon console → Connection details → pooled).
DATABASE_URL=

# Long random string that signs login sessions:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Public URL of the site (local dev: http://localhost:5173).
APP_URL=

# AI assistant key (server-side only, never sent to the browser).
DEEPSEEK_API_KEY=

# Stripe (Dashboard → Developers). Leave empty locally to use test mode without charging.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Blob file storage. Added automatically on Vercel when you connect a Blob store.
# Leave empty locally to store files on disk.
BLOB_READ_WRITE_TOKEN=
